{
  "name": "xarab",
  "version": "1.0.0",
  "description": "A terminal assistant with remote tier routing and a single-model mode",
  "bin": {
    "xarab": "bin/xarab.js",
    "xarab-one": "bin/xarab-one.js"
  },
  "scripts": {
    "start": "tsx src/tiered/entry.jsx",
    "logo:generate": "node scripts/generate-scarab.js",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "classifier:evaluate": "node scripts/evaluate-classifier.js",
    "make:install": "node scripts/make-install.js",
    "test": "node --import ./scripts/test-environment.js --import tsx --test \"test/**/*.test.js\"",
    "start:one": "tsx src/single/entry.jsx"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "diff": "^9.0.0",
    "handlebars": "^4.7.10",
    "marked": "^18.1.0",
    "node-llama-cpp": "^3.22.1",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "tsx": "^4.23.15",
    "wrap-ansi": "^10.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10"
  }
}
